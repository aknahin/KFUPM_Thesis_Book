	file = {Full Text PDF:/home/aknahin/snap/zotero-snap/common/Zotero/storage/GX6K52BN/Ju et al. - 2022 - Printed Circuit Board (PCB) Routing optimization with an Innovative Edge Connector for PCI-Express 5.pdf:application/pdf},
