@article{li_fanoutnet_2023,
	title = {{FanoutNet}: a neuralized {PCB} fanout automation method using deep reinforcement learning},
	volume = {37},
	issn = {2374-3468, 2159-5399},
	shorttitle = {{FanoutNet}},
	url = {https://ojs.aaai.org/index.php/AAAI/article/view/26030},
	doi = {10.1609/aaai.v37i7.26030},
	abstract = {In modern electronic manufacturing processes, multi-layer Printed Circuit Board (PCB) routing requires connecting more than hundreds of nets with perplexing topology under complex routing constraints and highly limited resources, so that takes intense effort and time of human engineers. PCB fanout as a pre-design of PCB routing has been proved to be an ideal technique to reduce the complexity of PCB routing by pre-allocating resources and pre-routing. However, current PCB fanout design heavily relies on the experience of human engineers, and there is no existing solution for PCB fanout automation in industry, which limits the quality of PCB routing automation. To address the problem, we propose a neuralized PCB fanout method by deep reinforcement learning. To the best of our knowledge, we are the first in the literature to propose the automation method for PCB fanout. We combine with Convolution Neural Network (CNN) and attentionbased network to train our fanout policy model and value model. The models learn representations of PCB layout and netlist to make decisions and evaluations in place of human engineers. We employ Proximal Policy Optimization (PPO) to update the parameters of the models. In addition, we apply our PCB fanout method to a PCB router to improve the quality of PCB routing. Extensive experimental results on realworld industrial PCB benchmarks demonstrate that our approach achieves 100\% routability in all industrial cases and improves wire length by an average of 6.8\%, which makes a significant improvement compared with the state-of-the-art methods.},
	language = {en},
	number = {7},
	urldate = {2025-02-04},
	journal = {Proceedings of the AAAI Conference on Artificial Intelligence},
	author = {Li, Haiyun and Zhang, Jixin and Xu, Ning and Liu, Mingyu},
	month = jun,
	year = {2023},
	
	keywords = {notion, Reinforcement Learning},
	pages = {8554--8561},
	file = {PDF:/home/aknahin/snap/zotero-snap/common/Zotero/storage/8S2FUJ9H/Li et al. - 2023 - FanoutNet a neuralized PCB fanout automation method using deep reinforcement learning.pdf:application/pdf},
}

@inproceedings{li_ser-net_2024,
	title = {{SER}-{NET}: {A} {Neuralize} {PCB} {Simulataneous} {Escape} {Routing} {Method} {Using} {Deep} {Reinforcement} {Learning}},
	shorttitle = {{SER}-{NET}},
	url = {https://ieeexplore.ieee.org/document/10814469/},
	doi = {10.1109/ICICM63644.2024.10814469},
	abstract = {Simultaneous escape routing is a challenging issue in PCB routing, as it involves the escape of pins within two integrated circuits (ICs) to boundaries under limited resources and net order constraints. With advancements in IC fabrication technologies, there has been an increase in the number of pins in ICs and a reduction in package size, further complicating the simultaneous escape problem in printed circuit boards (PCBs). Our approach addresses this problem by dividing it into two stages: escape endpoint assignment and end-to-end routing. We utilize graphical convolutional neural networks and attention-based networks to create policy and value models for specifying escape endpoints. These models learn PCB layouts and nets representations to replace human decision-making and evaluation. Through near-end policy optimization, we update the model parameters. We then apply the model outputs to a congestion negotiation-based router to enhance the quality of simultaneous escape routing. Our method consistently achieves 100\% routability in all cases, outperforming other routers that can only complete routing for a portion of the problem.},
	urldate = {2025-04-06},
	booktitle = {2024 9th {International} {Conference} on {Integrated} {Circuits} and {Microsystems} ({ICICM})},
	author = {Li, Tianyi and Xu, Ning and Chi, Qingjia and Cai, Hao and Wang, Hongyuan},
	month = oct,
	year = {2024},
	
	keywords = {Optimization, Layout, escape routing, notion, Printed circuits, Routing, Pins, Micromechanical devices, Packaging, Integrated circuit modeling, Reinforcement Learning, Deep reinforcement learning, Convolutional neural networks, deep reinforcement learning, PCB},
	pages = {411--418},
	file = {Full Text PDF:/home/aknahin/snap/zotero-snap/common/Zotero/storage/VW97IBRQ/Li et al. - 2024 - SER-NET A Neuralize PCB Simulataneous Escape Routing Method Using Deep Reinforcement Learning.pdf:application/pdf},
}

@article{goh_consumer_2023,
