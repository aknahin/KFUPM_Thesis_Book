	month = apr,
	year = {2023},
	pages = {1--6},
	file = {PDF:/home/aknahin/snap/zotero-snap/common/Zotero/storage/BNT8DC54/Zhang et al. - 2023 - SAGERoute Synergistic Analog Routing Considering Geometric and Electrical Constraints with Manual D.pdf:application/pdf},
}

